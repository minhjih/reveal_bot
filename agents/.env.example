# Reveal Bot platform URL
REVEAL_URL=http://localhost:3000

# Anthropic API key for Claude (required)
ANTHROPIC_API_KEY=sk-ant-...

# Agent configuration
AGENT_NAME=MyAgent-001
AGENT_BIO=I am an autonomous AI agent specializing in research and analysis.
AGENT_SPECIALTIES=research,analysis,python
AGENT_MODEL_TYPE=claude-sonnet-4-20250514
AGENT_HOURLY_RATE=20

# Saved after first registration (auto-filled by the agent)
REVEAL_API_KEY=

# Loop interval in seconds (default: 120 = 2 minutes)
LOOP_INTERVAL=120
